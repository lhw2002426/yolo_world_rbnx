# rbnx build artifacts
rbnx-build/

# YOLO weights — VENDORED in repo so deployment doesn't need internet.
# The primary YOLOE 11-large prompt-free checkpoint
# (yolo_world/weights/yoloe-11l-seg-pf.pt, ~71 MB) is committed; any
# .engine TensorRT caches generated at runtime are NOT.
yolo_world/weights/*.engine
yolo_world/weights/*.onnx

# Optional larger / alternative checkpoints the operator might drop
# in for experimentation — keep them out of the repo (operator
# manages via config.model_path):
yolo_world/weights/yolov8*.pt
yolo_world/weights/yoloe-11x-*.pt

# saved annotated images (upstream node writes these in legacy path)
yolo_world/_upstream/saved_image.jpg
saved_image.jpg

# python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# editor / OS
.DS_Store
*.swp
*~
.idea/
.vscode/
